APP_NAME=Erudsway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=dev
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local services: docker compose -f infra/docker-compose.dev.yml up -d
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erudsway
DB_USERNAME=erudsway
DB_PASSWORD=erudsway

# Sanctum SPA (cookie) auth: web and API share the parent domain.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production: .erudsway.com (shared by www. and api.). Local: null (host-only cookie works across ports).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@erudsway.com"
MAIL_FROM_NAME="${APP_NAME}"

# Video playback (Phase 4). Must match the secret in docs/deploy/nginx-hls.conf in production.
MEDIA_SECURE_LINK_SECRET=
# Where signed segment URLs point (the host Nginx serves /hls/ on). Defaults to APP_URL.
# MEDIA_SEGMENT_URL=
