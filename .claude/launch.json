{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-d",
        "opcache.enable_cli=0",
        "apps/api/artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "start",
        "-p",
        "3000"
      ],
      "port": 3000
    }
  ]
}
